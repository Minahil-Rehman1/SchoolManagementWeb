@using System.Data
@{ViewData["Title"]="Management";string s=ViewBag.Section??"Students",search=ViewBag.Search??"",error=ViewBag.Error??"";DataTable t=ViewBag.Data as DataTable??new();DataTable classStudents=ViewBag.ClassStudents as DataTable??new();}
<div class="container py-4 management-theme"><div class="d-flex justify-content-between align-items-center"><div><h2>School Management</h2><p class="text-muted">Organised records for your school.</p></div><a href="/Home" class="btn btn-outline-secondary">Dashboard</a></div>
<div class="mb-3">@foreach(var x in new[]{"Students","Teachers","Classes","Assessments"}){<a href="/Management?section=@x" class="btn @(s==x?"btn-primary":"btn-outline-primary") me-1">@x</a>}</div>
@if(!string.IsNullOrEmpty(error)){<div class="alert alert-danger">@error</div>}<div class="card shadow-sm border-0 mb-3"><div class="card-body d-flex gap-2"><form method="get" class="d-flex flex-grow-1"><input type="hidden" name="section" value="@s"/><input name="search" value="@search" class="form-control me-2" placeholder="Search @s"/><button class="btn btn-secondary">Search</button></form><a class="btn btn-success" href="/Management/Create?section=@s">+ Add @s</a></div></div>
@if(t.Rows.Count==0){<div class="alert alert-info">No @s records found.</div>}
else if(s=="Students"){@for(int g=1;g<=12;g++){var rows=t.AsEnumerable().Where(r=>r.Field<int>("grade")==g).ToList();if(rows.Any()){<div class="card shadow-sm border-0 mb-3"><div class="card-header"><strong>Grade @g</strong> <span class="text-muted">(@rows.Count students)</span></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Roll</th><th>Name</th><th>Gender</th><th>Age</th><th>Section</th><th>Class</th><th></th></tr></thead><tbody>@foreach(var r in rows){<tr><td>@r["roll_number"]</td><td>@r["name"]</td><td>@r["gender"]</td><td>@r["age"]</td><td>@r["section"]</td><td>@r["class_name"]</td><td><a class="btn btn-sm btn-outline-primary" href="/Management/Edit?section=Students&id=@r["roll_number"]">Edit</a> @await Html.PartialAsync("_Delete",new { section="Students",id=r["roll_number"],label="student"})</td></tr>}</tbody></table></div></div>}}}
else {<div class="card shadow-sm border-0"><div class="table-responsive"><table class="table mb-0"><thead><tr>@if(s=="Teachers"){<th>ID</th><th>Name</th><th>Gender</th><th>Age</th><th>Subject</th>}else if(s=="Classes"){<th>Class</th><th>Grade</th><th>Section</th><th>Teacher</th><th>Strength</th><th>Students</th>}else{<th>ID</th><th>Roll</th><th>Student</th><th>Assessment</th><th>Marks</th><th>Total</th><th>Date</th>}<th></th></tr></thead><tbody>@foreach(DataRow r in t.Rows){<tr>@if(s=="Teachers"){<td>@r["teacher_id"]</td><td>@r["name"]</td><td>@r["gender"]</td><td>@r["age"]</td><td>@r["subject"]</td>}else if(s=="Classes"){<td>@r["class_id"]</td><td>Grade @r["grade"]</td><td>@r["section"]</td><td>@r["teacher_id"] — @r["teacher_name"]</td><td>@r["student_strength"] / 100</td><td><button class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#c@r["class_id"]">Show</button></td>}else{<td>@r["assessment_id"]</td><td>@r["roll_number"]</td><td>@r["student_name"]</td><td>@r["assessment_name"]</td><td>@r["marks"]</td><td>@r["total_marks"]</td><td>@Convert.ToDateTime(r["assessment_date"]).ToString("dd MMM yyyy")</td>}<td><a class="btn btn-sm btn-outline-primary" href="/Management/Edit?section=@s&id=@(s=="Teachers"?r["teacher_id"]:s=="Classes"?r["class_id"]:r["assessment_id"])">Edit</a> @await Html.PartialAsync("_Delete",new { section=s,id=s=="Teachers"?r["teacher_id"]:s=="Classes"?r["class_id"]:r["assessment_id"],label=s.ToLowerInvariant()})</td></tr>@if(s=="Classes"){var pupils=classStudents.AsEnumerable().Where(x=>x.Field<int>("class_id")==r.Field<int>("class_id"));<tr class="collapse" id="c@r["class_id"]"><td colspan="7"><strong>Students</strong><ul class="mb-0">@foreach(var p in pupils){<li>@p["roll_number"] — @p["name"]</li>}</ul></td></tr>}}</tbody></table></div></div>}</div>
