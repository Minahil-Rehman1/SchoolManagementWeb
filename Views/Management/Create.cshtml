@using System.Data

@{
    ViewData["Title"] = "Add " + ViewBag.Section;
    string section = ViewBag.Section ?? "Students";
}

<div class="container py-4 management-theme">

    <div class="card shadow-sm border-0 mx-auto" style="max-width:700px;border-radius:20px;">
        <div class="card-body p-4">

            <h2 class="mb-4" style="color:#6f5848;">
                Add @(section)
            </h2>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="section" value="@(section)" />

                @if (section == "Students")
                {
                    <div class="mb-3">
                        <label class="form-label">Grade</label>
                        <select name="grade" id="studentGrade" class="form-select" required>
                            <option value="">Select Grade</option>

                            @for (int i = 1; i <= 12; i++)
                            {
                                <option value="@i">Grade @i</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Roll Number</label>
                        <input type="number"
                               name="roll_number"
                               id="studentRoll"
                               class="form-control"
                               min="100"
                               max="1299"
                               readonly
                               required />

                        <small class="text-muted">
                            Roll number is automatically assigned according to the selected grade.
                        </small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Student Name</label>
                        <input type="text"
                               name="name"
                               class="form-control text-capitalize"
                               maxlength="100"
                               pattern="[A-Za-z]+(?:[ '-][A-Za-z]+)*"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Gender</label>
                        <select name="gender" class="form-select" required>
                            <option value="">Select Gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Age</label>
                        <input type="number"
                               name="age"
                               class="form-control"
                               min="4"
                               max="25"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Section</label>
                        <select name="class_section" class="form-select" required>
                            <option value="">Select Section</option>
                            <option value="A">A</option>
                            <option value="B">B</option>
                            <option value="C">C</option>
                            <option value="D">D</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Class</label>
                        <select name="class_id" class="form-select" required>
                            <option value="">Select Class</option>

                            @if (ViewBag.Classes != null)
                            {
                                foreach (DataRow row in ViewBag.Classes.Rows)
                                {
                                    <option value="@row["class_id"]">
                                        Grade @row["grade"] - @row["section"]
                                    </option>
                                }
                            }
                        </select>
                    </div>
                }

                @if (section == "Teachers")
                {
                    <div class="mb-3">
                        <label class="form-label">Teacher ID</label>
                        <input type="text"
                               class="form-control"
                               value="Auto Generated"
                               readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Teacher Name</label>
                        <input type="text"
                               name="name"
                               class="form-control text-capitalize"
                               maxlength="100"
                               pattern="[A-Za-z]+(?:[ '-][A-Za-z]+)*"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Gender</label>
                        <select name="gender" class="form-select" required>
                            <option value="">Select Gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Age</label>
                        <input type="number"
                               name="age"
                               class="form-control"
                               min="21"
                               max="70"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Subject</label>
                        <input type="text"
                               name="subject"
                               class="form-control text-capitalize"
                               maxlength="100"
                               pattern="[A-Za-z]+(?:[ '-][A-Za-z]+)*"
                               required />
                    </div>
                }

                @if (section == "Classes")
                {
                    <div class="mb-3">
                        <label class="form-label">Class ID</label>
                        <input type="text"
                               class="form-control"
                               value="Auto Generated"
                               readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Grade</label>
                        <select name="grade" class="form-select" required>
                            <option value="">Select Grade</option>

                            @for (int i = 1; i <= 12; i++)
                            {
                                <option value="@i">Grade @i</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Section</label>
                        <select name="class_section" class="form-select" required>
                            <option value="">Select Section</option>
                            <option value="A">A</option>
                            <option value="B">B</option>
                            <option value="C">C</option>
                            <option value="D">D</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Teacher</label>

                        <select name="teacher_id" class="form-select" required>
                            <option value="">Select Teacher</option>

                            @if (ViewBag.Teachers != null)
                            {
                                foreach (DataRow row in ViewBag.Teachers.Rows)
                                {
                                    <option value="@row["teacher_id"]">
                                        @row["teacher_id"] - @row["name"]
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <div class="alert alert-info">
                        Each class can hold up to <strong>100 students</strong>.
                    </div>
                }

                @if (section == "Assessments")
                {
                    <div class="mb-3">
                        <label class="form-label">Assessment ID</label>
                        <input type="text"
                               class="form-control"
                               value="Auto Generated"
                               readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Student</label>

                        <select name="roll_number" class="form-select" required>
                            <option value="">Select Student</option>

                            @if (ViewBag.Students != null)
                            {
                                foreach (DataRow row in ViewBag.Students.Rows)
                                {
                                    <option value="@row["roll_number"]">
                                        @row["roll_number"] - @row["name"] - Grade @row["grade"]
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Assessment Name</label>
                        <input type="text"
                               name="assessment_name"
                               class="form-control text-capitalize"
                               maxlength="100"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Obtained Marks</label>
                        <input type="number"
                               name="marks"
                               class="form-control"
                               min="0"
                               step="0.01"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Total Marks</label>
                        <input type="number"
                               name="total_marks"
                               class="form-control"
                               min="1"
                               step="0.01"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Assessment Date</label>
                        <input type="date"
                               name="assessment_date"
                               class="form-control"
                               max="@DateTime.Now.ToString("yyyy-MM-dd")"
                               required />
                    </div>
                }

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">
                        Save
                    </button>

                    <a href="/Management?section=@(section)"
                       class="btn btn-light ms-2">
                        Cancel
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('input[type="text"].text-capitalize')
        .forEach(function (input) {

            input.addEventListener('input', function () {

                this.value = this.value
                    .toLowerCase()
                    .replace(/\b\w/g, function (letter) {
                        return letter.toUpperCase();
                    });
            });
        });
</script>